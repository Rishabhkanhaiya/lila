# ============================================================
# Lila AI Companion — Environment Configuration
# ============================================================
# 1. Copy this file to .env in the same directory:
#       cp .env.example .env
# 2. Fill in your own API keys below.
# 3. The .env file is git-ignored and will NEVER be pushed to GitHub.
# ============================================================

# ── Core AI (Required) ──────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ── Extended AI (Optional fallbacks) ────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
TOGETHER_API_KEY=your_together_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here

# ── Search / Research Tools (Optional) ──────────────────────
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=your_serper_api_key_here
EXA_API_KEY=your_exa_api_key_here
BRAVE_API_KEY=your_brave_api_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here

# ── IoT / Smart Home via MQTT (Optional) ────────────────────
# Leave MQTT_BROKER as 127.0.0.1 for local Mosquitto broker.
# Leave MQTT_USER/MQTT_PASS blank if no auth needed.
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_ENABLED=false

# ── Voice Activity Detection ─────────────────────────────────
# Sensitivity for microphone speech detection (RMS volume).
# Increase if Lila triggers on ambient noise. Default: 260.0
LILA_VAD_THRESHOLD=260.0
